    <property name="queryDataViewInfos">
        <![CDATA[{
            "size": #[size],
            #if($from)
            "from": #[from],
            #end
            "query" : {
                "bool": {
                    "must": [
                        #if($items && $items.size() > 0)
                            #set($needComma = false)
                            #foreach($item in $items.entrySet())
                                #if($needComma), #else #set($needComma = true) #end
                                {
                                    "terms": {
                                        "$item.key": #[items[$item.key],serialJson=true]
                                    }
                                }
                            #end
                        #end

                        #if($itemPros && $itemPros.size() > 0)
                            #if($items && $items.size() > 0), #end
                            #set($needComma = false)
                            #foreach($itemPro in $itemPros.entrySet())
                                #if($needComma), #else #set($needComma = true) #end
                                    {
                                        "match": {
                                            "$itemPro.key": {
                                                "query": #[itemPros[$itemPro.key]],
                                                "operator": "and"
                                           }
                                        }
                                    }
                            #end
                        #end

                        #if($ancestorsItem && $ancestorsItem.size() > 0)
                            #if($items && $items.size() > 0 || $itemPros && $itemPros.size() > 0), #end
                            #set($needComma = false)
                            #foreach($ancestors in $ancestorsItem.entrySet())
                                #if($needComma), #else #set($needComma = true) #end
                                {
                                    "terms": {
                                        "$ancestors.key": #[ancestorsItem[$ancestors.key],serialJson=true]
                                    }
                                }
                            #end
                        #end

                        #if($ancestorsPros && $ancestorsPros.size() > 0)
                            #if($items && $items.size() > 0 || $itemPros && $itemPros.size() > 0 || $ancestorsItem && $ancestorsItem.size() > 0), #end
                            #set($needFirstComma = true)
                            #set($needComma = false)
                            #foreach($ancestorsPro in $ancestorsPros.entrySet())
                                #if($needComma), #else
                                    {
                                        "match": {
                                            "$ancestorsPro.key": {
                                                "query": #[ancestorsPros[$ancestorsPro.key]],
                                                "operator": "and"
                                           }
                                        }
                                    }
                                #set($needComma = true) #end
                            #end
                        #end

                        #if($posterityItems && $posterityItems.size() > 0 || $posterityPros && $posterityPros.size()  > 0)
                            #if($items && $items.size() > 0 || $itemPros && $itemPros.size() > 0 || $ancestorsItem && $ancestorsItem.size() > 0 || $ancestorsPros && $ancestorsPros.size() > 0), #end
                            {
                                "nested": {
                                    "path": "posterityItems",
                                    "query": {
                                        "bool":{
                                            "must":[
                                                #if($posterityItems && $posterityItems.size() > 0)
                                                    #set($needComma = false)
                                                    #foreach($posterity in $posterityItems.entrySet())
                                                        #if($needComma), #else #set($needComma = true) #end
                                                            {
                                                                "terms": {
                                                                    "$posterity.key": #[posterityItems[$posterity.key],serialJson=true]
                                                                }
                                                            }
                                                    #end
                                                #end

                                                #if($posterityPros && $posterityPros.size() > 0)
                                                    #if($posterityItems && $posterityItems.size() > 0), #end
                                                    #set($needComma = false)
                                                    #foreach($posterityPro in $posterityPros.entrySet())
                                                        #if($needComma), #else #set($needComma = true) #end
                                                            {
                                                                "match": {
                                                                    "$posterityPro.key": {
                                                                        "query": #[posterityPros[$posterityPro.key]],
                                                                        "operator": "and"
                                                                   }
                                                                }
                                                            }
                                                    #end
                                                #end
                                            ]
                                        }
                                    }
                                }
                            }
                        #end
                    ]
                }
            }
	    }]]>

    </property>

