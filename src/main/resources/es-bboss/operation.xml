    <property name="createIndex">
        <![CDATA[{
            "settings": {
                "index.mapping.total_fields.limit": 100000,
                "index.max_result_window": 1000000000,
                "refresh_interval": -1,
                "analysis": {
                    "normalizer": {
                        "lowercase": {
                            "type": "custom",
                            "filter": [
                                "lowercase"
                            ]
                        }
                    },
                    "analyzer": {
                        "char_analyzer": {
                            "tokenizer": "char_tokenizer",
                            "filter": "lowercase"
                        }
                    },
                    "tokenizer": {
                        "char_tokenizer": {
                            "type": "pattern",
                            "pattern": "|"
                        }
                    }
                }
            },
            "mappings": {
                "date_detection": false,
                    "dynamic_templates": [{
                        "strings": {
                            "match_mapping_type": "string",
                            "mapping": {
                                "type": "text",
                                "analyzer": "char_analyzer",
                                "fields": {
                                    "keyword": {
                                      "type":  "keyword",
                                      "normalizer": "lowercase"
                                    },
                                    "text": {
                                      "type":  "text",
                                      "analyzer": "char_analyzer"
                                    }
                                }
                            }
                        }
                    }],
                    "dynamic": "strict",
                    "properties": {
                        "tag": {
                            "type": "text",
                            "fields": {
                                "keyword": {
                                    "type": "keyword",
                                    "normalizer": "lowercase"
                                },
                                "text": {
                                    "type": "text",
                                    "analyzer": "char_analyzer"
                                }
                            },
                            "analyzer":"char_analyzer"
                        },
                        "compositions": {
                            "type":"text",
                            "fields":{
                                "keyword": {
                                    "type": "keyword",
                                    "normalizer": "lowercase"
                                },
                                "text": {
                                    "type": "text",
                                    "analyzer": "char_analyzer"
                                }
                            },
                            "analyzer":"char_analyzer"
                        },
                        "categories": {
                            "type":"text",
                            "fields":{
                                "keyword": {
                                    "type": "keyword",
                                    "normalizer": "lowercase"
                                },
                                "text": {
                                    "type": "text",
                                    "analyzer": "char_analyzer"
                                }
                            },
