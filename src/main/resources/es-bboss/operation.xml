    <property name="createDocumentIndex">
        <![CDATA[{
            "settings": {
                "index.mapping.total_fields.limit": 100000,
                "index.mapping.nested_fields.limit": 1000,
                "index.max_result_window": 10000,
                "refresh_interval": -1,
                "analysis": {
                    "normalizer": {
                        "lowercase": {
                            "type": "custom",
                            "filter": [
                                "lowercase"
                            ]
                        }
                    },
                    "analyzer": {
                        "char_analyzer": {
                            "tokenizer": "char_tokenizer",
                            "filter": "lowercase"
                        }
                    },
                    "tokenizer": {
                        "char_tokenizer": {
                            "type": "pattern",
                            "pattern": "|"
                        }
                    }
                }
            },
            "mappings": {
                "_doc": {
                    "date_detection": false,
                    "dynamic": "strict",
                    "properties": {
                        "name": {
                            "type": "text",
                            "fields": {
                                "keyword": {
                                    "type": "keyword",
                                    "normalizer": "lowercase"
                                },
                                "text": {
                                    "type": "text",
                                    "analyzer": "char_analyzer"
                                }
                            },
                            "analyzer": "char_analyzer"
                        },
                        "categories": {
                            "type": "text",
                            "fields": {
                                "keyword": {
                                    "type": "keyword",
                                    "normalizer": "lowercase"
                                },
                                "text": {
                                    "type": "text",
                                    "analyzer": "char_analyzer"
                                }
                            },
                            "analyzer": "char_analyzer"
                        },
                        "properties": {
                            "dynamic": "true",
                            "type": "object"
                        },
                        "contents": {
                            "properties": {
                                "blocks": {
                                    "type": "nested",
                                    "properties": {
                                        "pageNumber": {
                                            "type": "integer"
                                        },
                                        "location": {
                                            "type": "keyword"
                                        },
                                        "text": {
                                            "type": "text",
                                            "analyzer": "char_analyzer"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }]]>
    </property>

    <property name="queryContentText">
        <![CDATA[{
            "from": #[from],
            "size": #[size],
            "_source": {
                "excludes": ["properties", "contents"]
            },
            "query": {
                "bool": {
                    "should": [
                        {
                            "query_string": {
                                "query": #[keywords],
                                "type": "phrase",
                                "default_operator": "OR",
                                "fields": ["name"]
                            }
                        },
                        {
                            "nested": {
                                "path": "contents.blocks",
                                "query": {
                                    "query_string": {
                                        "query": #[keywords],
                                        "type": "phrase",
                                        "default_operator": "OR",
                                        "fields": ["contents.blocks.text"]
                                    }
                                },
                                "inner_hits": {
                                    "highlight": {
                                        "order": "score",
                                        "pre_tags": [#[highlightClass]],
                                        "post_tags": [
                                            "</span>"
                                        ],
                                        "fields": [
                                            {
                                                "contents.blocks.text": {
                                                    "fragment_size": #[fragmentSize],
                                                    "number_of_fragments": #[numberOfFragments]
                                                }
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    ]
                }
            },
            "highlight": {
                "order": "score",
                "pre_tags": [#[highlightClass]],
                "post_tags": [
                    "</span>"
                ],
                "fields": [
                    {
                        "name": {
                          "fragment_size": #[fragmentSize],
                          "number_of_fragments": #[numberOfFragments]
                        }
                    }
                ]
            }
        }]]>
    </property>

    <property name="queryItemsByItemIdsOrCategories">
        <![CDATA[{
            #set( $hasItemIds = false )
            #set( $hasTags = false )
            "size": #[size],
            "query" : {
                "bool": {
                    "must": [
                         #if($tags && $tags.size() > 0)
                         #set( $hasTags = true )
                            {
                                "terms": {
                                    "tag.keyword": #[tags,serialJson=true]
                                }
                            }
                        #end

                        #if($itemIds && $itemIds.size() > 0)
                        #if($hasTags),#end
                        #set( $hasItemIds = true )
                            {
                                "terms": {
                                    "_id": #[itemIds,serialJson=true]
                                }
                            }
                        #end

                        #if($categories && $categories.size() > 0)
                        #if($hasItemIds || $hasTags),#end
                            {
                                "terms": {
                                    "categories.keyword": #[categories,serialJson=true]
                                }
                            }
                         #end
                    ]
                }
            }
	    }]]>
    </property>

    <!--  批量获取reference相关索引  -->
    <property name="queryReferencesBySourceDocumentIdAndOther">
        <![CDATA[{
            #set( $hasTags = false )
            "size": #[size],
            "query": {
                "bool": {
                    "must": [
                        #if($sourceDocumentId)
                        #set( $hasTags = true )
                            {
                                "term": {
                                    "sourceDocumentId.keyword": {
                                        "value": #[sourceDocumentId, serialJson=true]
                                    }
                                }
                            }
                        #end

                        #if($targetDocumentId )
                        #if($hasTags),#end
                        #set( $hasTags = true )
                            {
                                "term": {
                                    "targetDocumentId.keyword": {
                                        "value": #[targetDocumentId, serialJson=true]
                                    }
                                }
                            }
                        #end

                        #if($handle)
                        #if($hasTags),#end
                        #set( $hasTags = true )
                            {
                                "term": {
                                    "handle.keyword": {
                                        "value": #[handle, serialJson=true]
                                    }
                                }
                            }
                        #end

                        #if($targetItemId)
                        #if($hasTags),#end
                            {
                                "term": {
                                    "targetItemId.keyword": {
                                        "value": #[targetItemId, serialJson=true]
                                    }
                                }
                            }
                        #end
                    ]
                }
            }
	    }]]>
    </property>

